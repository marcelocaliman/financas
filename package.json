{
  "name": "financas",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@11.0.8",
  "engines": {
    "node": ">=22 <23"
  },
  "scripts": {
    "dev": "NODE_OPTIONS=--max-http-header-size=65536 next dev",
    "build": "next build",
    "start": "NODE_OPTIONS=--max-http-header-size=65536 next start",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "validate": "pnpm run typecheck && pnpm run test",
    "validate:full": "pnpm run typecheck && pnpm run lint && pnpm run test",
    "ci": "pnpm run validate",
    "db:push": "bash scripts/db-push.sh",
    "db:diff": "bash scripts/db-diff.sh",
    "db:types": "node scripts/db-types.mjs"
  },
