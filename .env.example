# ============================================================================
# Finanças — variáveis de ambiente
# Copie pra `.env.local` (gitignorado) e preencha. Nunca commite credenciais.
# ============================================================================

# ----- Supabase -------------------------------------------------------------
# Encontre em: Supabase Dashboard > Settings > API
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Service Role — apenas server-side, NUNCA expor no client.
# Encontre em: Supabase Dashboard > Settings > API > service_role secret
SUPABASE_SERVICE_ROLE_KEY=

# Senha do banco Postgres — para o Supabase CLI rodar migrations.
# Definida quando você criou o projeto Supabase.
SUPABASE_DB_PASSWORD=

# Project ref — o slug do projeto no Supabase (ex.: abcdefghijklmno).
SUPABASE_PROJECT_REF=

# ----- App ------------------------------------------------------------------
# URL pública do app (usado em magic-link redirects e metadata)
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ----- Futuro --------------------------------------------------------------
# Fase 6 (IA) — deixar vazios por enquanto.
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# Fase 3 (cotações B3) — deixar vazio por enquanto.
BRAPI_TOKEN=
