# ============================================================================
# Finanças — variáveis de ambiente
# Copie pra `.env.local` (gitignorado) e preencha. Nunca commite credenciais.
#
# Validação: `lib/env.ts` valida tudo no boot (Zod). Em produção, faltar uma
# var OBRIGATÓRIA derruba o boot (fail-fast). Integrações "engatilhadas"
# (Stripe, Sentry, Upstash, QStash, Turnstile) são OPCIONAIS: sem a chave, o
# código degrada para no-op. Ligar = só preencher a variável.
# ============================================================================

# ████ OBRIGATÓRIO ███████████████████████████████████████████████████████████

# ----- Supabase -------------------------------------------------------------
# Supabase Dashboard > Settings > API
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Service Role — apenas server-side, NUNCA expor no client.
SUPABASE_SERVICE_ROLE_KEY=

# ----- App ------------------------------------------------------------------
# URL pública (magic-link redirects, metadata, e-mails). Em prod: https://...
NEXT_PUBLIC_APP_URL=http://localhost:3000


# ████ MIGRATIONS / CLI (local) ██████████████████████████████████████████████
# Necessárias só pra rodar `pnpm db:push` / `pnpm db:types` da sua máquina.
SUPABASE_DB_PASSWORD=
SUPABASE_PROJECT_REF=
# Personal Access Token — gere em https://supabase.com/dashboard/account/tokens
SUPABASE_ACCESS_TOKEN=


# ████ CRONS █████████████████████████████████████████████████████████████████
# Protege /api/cron/* contra invocação externa. Na Vercel, o header
# x-vercel-cron autentica os jobs de vercel.json automaticamente; fora dela,
# mande `Authorization: Bearer $CRON_SECRET`.
CRON_SECRET=
# Pra onde mandar alertas de falha de cron.
CRON_ALERT_EMAIL=


# ████ E-MAIL (Resend) ███████████████████████████████████████████████████████
# Sem RESEND_API_KEY, os e-mails transacionais ficam desligados (no-op).
RESEND_API_KEY=
EMAIL_FROM=
# E-mail de contato exibido em /privacidade, /termos e rodapés.
NEXT_PUBLIC_CONTACT_EMAIL=


# ████ IA (OpenAI / Anthropic) ███████████████████████████████████████████████
# Sem OPENAI_API_KEY, /inbox fica visível mas o upload é desabilitado.
# Modelo default: gpt-4o-mini (override via OPENAI_MODEL).
OPENAI_API_KEY=
OPENAI_MODEL=
ANTHROPIC_API_KEY=
# Orçamento mensal de IA por household, em centavos. Default por tier no código;
# esta var é um override global opcional.
MONTHLY_AI_BUDGET_CENTS=


# ████ DADOS EXTERNOS / CÂMBIO ███████████████████████████████████████████████
# Cotações B3 (brapi.dev). Sem token, usa o tier público (limitado).
BRAPI_TOKEN=
# Liga a fonte PTAX (BCB) no cron de câmbio — exigida pela Receita para o IR.
BCB_PTAX_ENABLED=false


# ████ AUTH HOOK (Supabase) ██████████████████████████████████████████████████
SUPABASE_AUTH_HOOK_SECRET=


# ============================================================================
# ██ ENGATILHADO — tudo abaixo é OPCIONAL. Sem a chave, vira no-op. ██████████
# ============================================================================

# ----- Billing (Stripe) -----------------------------------------------------
# ÚNICA PENDÊNCIA do billing: criar a conta Stripe e preencher estas 6 vars.
# Todo o código (checkout, webhook, portal, dunning, gating) já está pronto e
# testado em test-mode. Ver seção 3 do ROADMAP.md ("ligar o billing").
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_PRO_MONTHLY=
STRIPE_PRICE_FAMILY_MONTHLY=
STRIPE_PRICE_LIFETIME=
# Liga toda a superfície de billing (CTAs, página de planos, checkout).
NEXT_PUBLIC_STRIPE_BILLING_ENABLED=false

# ----- Observabilidade (Sentry) ---------------------------------------------
# Sem DSN, instrumentation/error-boundaries funcionam mas não enviam nada.
SENTRY_DSN=
NEXT_PUBLIC_SENTRY_DSN=
# Pra upload de sourcemaps no build (Vercel/CI).
SENTRY_AUTH_TOKEN=
SENTRY_ORG=
SENTRY_PROJECT=
SENTRY_ENVIRONMENT=

# ----- Rate-limit / cache (Upstash) -----------------------------------------
# OPCIONAL: o rate-limit do núcleo é via RPC Postgres (consume_rate_limit).
# Estas vars só são necessárias se você optar por throttle de borda por IP.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# ----- Fila de jobs (QStash) ------------------------------------------------
# Modelo cron → worker por household. Sem QSTASH_TOKEN, roda o caminho legado.
QSTASH_TOKEN=
QSTASH_CURRENT_SIGNING_KEY=
QSTASH_NEXT_SIGNING_KEY=
JOBS_QUEUE_ENABLED=false

# ----- Anti-abuso (captcha Cloudflare Turnstile) ----------------------------
TURNSTILE_SECRET_KEY=
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
# Desliga o rate-limit de auth (apenas dev/e2e).
AUTH_RATELIMIT_DISABLED=false

# ----- LGPD -----------------------------------------------------------------
# Janela de arrependimento antes do hard-delete da conta (dias).
LGPD_DELETION_GRACE_DAYS=7
# E-mail do Encarregado de Dados (DPO) exibido em /privacidade.
LGPD_DPO_EMAIL=
