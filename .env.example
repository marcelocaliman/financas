# ============================================================================
# Finanças — variáveis de ambiente
# Copie pra `.env.local` (gitignorado) e preencha. Nunca commite credenciais.
# ============================================================================

# ----- Supabase -------------------------------------------------------------
# Encontre em: Supabase Dashboard > Settings > API
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Service Role — apenas server-side, NUNCA expor no client.
# Encontre em: Supabase Dashboard > Settings > API > service_role secret
SUPABASE_SERVICE_ROLE_KEY=

# Senha do banco Postgres — para o Supabase CLI rodar migrations.
# Definida quando você criou o projeto Supabase.
SUPABASE_DB_PASSWORD=

# Project ref — o slug do projeto no Supabase (ex.: abcdefghijklmno).
SUPABASE_PROJECT_REF=

# (Opcional) Personal Access Token para gerar types via Management API.
# Apenas se rodar `pnpm db:types`. Gere em https://supabase.com/dashboard/account/tokens
SUPABASE_ACCESS_TOKEN=

# ----- App ------------------------------------------------------------------
# URL pública do app (usado em magic-link redirects e metadata)
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ----- IA Document Inbox (/inbox) -------------------------------------------
# Pra ativar a leitura automática de documentos via /inbox.
# Sem essa chave, a página fica visível mas o upload é desabilitado.
# Modelo default: gpt-4o-mini (override via OPENAI_MODEL se quiser).
OPENAI_API_KEY=
OPENAI_MODEL=
ANTHROPIC_API_KEY=

# Fase 3 (cotações B3) — deixar vazio por enquanto.
BRAPI_TOKEN=

# ----- Crons ---------------------------------------------------------------
# Segredo pra proteger /api/cron/update-* contra invocação externa.
# Em produção (Vercel), o header `x-vercel-cron` autentica automaticamente os
# jobs agendados em vercel.json. Em outros ambientes, mande
# `Authorization: Bearer $CRON_SECRET` ao chamar.
CRON_SECRET=
